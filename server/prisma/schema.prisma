generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipoUsuario {
  aluno
  empresa
}

enum Turno {
  integral
  manha
  tarde
  noite
}

enum Modalidade {
  presencial
  remoto
  hibrido
}

model Usuario {
  id         Int         @id @default(autoincrement())
  nome       String
  email      String      @unique
  pswd       String
  telefone    String?
  nascimento  String?
  curso       String?
  cnpj        String?
  criadoEm    DateTime    @default(now())
  excluidoEm  DateTime?
  tipo        TipoUsuario

  vagas Vaga[]
  areas UsuarioArea[]

  @@map("usuarios")
}

model Area {
  id   Int    @id @default(autoincrement())
  nome String @unique

  vagas    Vaga[]
  usuarios UsuarioArea[]

  @@map("areas")
}

model UsuarioArea {
  usuarioId Int
  areaId    Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  area    Area    @relation(fields: [areaId], references: [id])

  @@id([usuarioId, areaId])
  @@map("usuario_area")
}

model Vaga {
  id              Int        @id @default(autoincrement())
  titulo          String
  descricao       String
  areaId          Int
  empresaId       Int
  turno           Turno
  modalidade      Modalidade
  salario         Float?
  preenchida      Boolean    @default(false)
  local           String?
  contatoNome     String?
  contatoTelefone String?
  contatoEmail    String?
  criadoEm        DateTime   @default(now())
  excluidoEm      DateTime?

  area       Area            @relation(fields: [areaId], references: [id])
  empresa    Usuario         @relation(fields: [empresaId], references: [id])
  beneficios VagaBeneficio[]

  @@map("vagas")
}

model Beneficio {
  id   Int    @id @default(autoincrement())
  nome String @unique

  vagas VagaBeneficio[]

  @@map("beneficios")
}

model VagaBeneficio {
  vagaId      Int
  beneficioId Int

  vaga      Vaga      @relation(fields: [vagaId], references: [id])
  beneficio Beneficio @relation(fields: [beneficioId], references: [id])

  @@id([vagaId, beneficioId])
  @@map("vaga_beneficio")
}
